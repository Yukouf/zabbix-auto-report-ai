# ==============================================================================
# Zabbix Auto Report - Configuration
# Copiez ce fichier en ".env" puis remplissez vos valeurs.
# Le fichier .env est ignoré par git : vos identifiants ne partiront jamais
# sur GitHub.
# ==============================================================================

# --- API Zabbix (utilisateur en LECTURE SEULE recommandé) ---
ZABBIX_URL=https://zabbix.mondomaine.local/api_jsonrpc.php
ZABBIX_USER=rapport-auto
ZABBIX_PASS=changez-moi
# true si votre certificat est valide, false si auto-signé
VERIFY_SSL=false

# --- Envoi email (laisser vide pour désactiver, ou utiliser --no-email) ---
SMTP_SERVER=smtp.mondomaine.com
SMTP_PORT=465
SMTP_USER=noreply
SMTP_PASS=changez-moi
SMTP_FROM=Zabbix Alertes <noreply@mondomaine.com>
SMTP_SENDER=noreply@mondomaine.com
# Destinataires séparés par des virgules
EMAIL_TO=it@mondomaine.com,manager@mondomaine.com

# --- Personnalisation du rapport ---
COMPANY_NAME=Mon Entreprise
REPORT_DIR=/opt/zabbix-auto-report/rapports

# --- IA locale (optionnelle : le référentiel fonctionne sans) ---
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b

# --- Adaptation à votre parc ---
# Mots-clés (dans les noms d'hôtes) identifiant vos équipements réseau
NETWORK_KEYWORDS=aruba,hp-2530,switch
# Motifs d'alertes à filtrer du rapport, séparés par des points-virgules
EXCLUDED_PATTERNS=Ethernet has changed to lower speed;Operating system description has changed;GoogleUpdater;Number of installed packages has been changed
